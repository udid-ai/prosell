# Prosell 스토어프론트 환경변수
# `npm run setup` 이 ~/.prosell-mcp/config.json(연결 자격증명)에서 값을 채워 .env.local 을 생성합니다.
# 수동으로 채울 경우 아래를 참고하세요.

# 클라이언트 ID
PROSELL_CLIENT_ID=

# 앱키 — 회원 로그인 토큰 발급에 사용. 서버에서만 사용(브라우저 노출 금지).
PROSELL_CLIENT_SECRET=

# 쇼핑몰 API base (예: https://myshopid.prosell.kr)
PROSELL_API_BASE=

# (선택) 로컬 도커에서 이미지 호스트 치환 (운영은 비워두기)
# PROSELL_IMAGE_BASE=http://localhost:8080

# (선택) 개발 서버를 localhost 가 아닌 도메인으로 열 때 허용할 호스트(쉼표 구분)
# 없으면 dev 모드에서 /_next/* 가 차단돼 일부 이미지가 안 보인다. 운영 빌드엔 무관.
# PROSELL_DEV_ORIGINS=demo-ai.prosell.kr
